NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
# Select eway, stripe, or manual per environment. Never use test keys on the live domain.
PAYMENT_PROVIDER=eway
EWAY_API_KEY=
EWAY_API_PASSWORD=
EWAY_ENVIRONMENT=sandbox
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_SITE_URL=http://127.0.0.1:3000
SES_AWS_ACCESS_KEY_ID=
SES_AWS_SECRET_ACCESS_KEY=
SES_AWS_SESSION_TOKEN=
SES_AWS_REGION=ap-southeast-2
SES_FROM_EMAIL=Ignyte Active <support@ignyteactive.com>
META_INSTAGRAM_APP_ID=
META_INSTAGRAM_APP_SECRET=
INSTAGRAM_OAUTH_REDIRECT_URI=https://dev.ignyteactive.com/api/instagram/oauth/callback
ORDER_NOTIFICATION_EMAIL=support@ignyteactive.com
# Set a unique random value of at least 32 characters. Mintsoft's ConnectAction
# ExtraCode4 must send it as: Authorization: Bearer <value>.
MINTSOFT_WEBHOOK_SECRET=
# Inventory API credentials are for the separate stock reconciliation rollout.
MINTSOFT_API_KEY=
MINTSOFT_WAREHOUSE_ID=
MINTSOFT_CLIENT_ID=
# Set to the service name mapped by the 3PL; AUTO uses their existing rules.
MINTSOFT_COURIER_SERVICE=AUTO
