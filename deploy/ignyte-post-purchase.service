[Unit]
Description=Run IGNYTE post-purchase journey
After=ignyte.service
Requires=ignyte.service

[Service]
Type=oneshot
User=ignyte
Group=ignyte
WorkingDirectory=/opt/ignyte/current
EnvironmentFile=-/etc/ignyte/production.env
ExecStart=/opt/ignyte/current/node /opt/ignyte/current/run-post-purchase.mjs
TimeoutStartSec=90
NoNewPrivileges=true
