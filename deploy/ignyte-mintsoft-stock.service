[Unit]
Description=Synchronize Ignyte stock from Mintsoft
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/home/internetremovals/.local/share/ignyte-stock-runtime
EnvironmentFile=/home/internetremovals/.config/ignyte/build.env
EnvironmentFile=/home/internetremovals/.config/ignyte/mintsoft.env
ExecStart=/home/internetremovals/.local/opt/node-v22.23.4-linux-x64/bin/node /home/internetremovals/.local/share/ignyte-stock-runtime/scripts/sync-mintsoft-stock.mjs --apply
TimeoutStartSec=90
